{
  "name": "taquito-boilerplate-react",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run check && pnpm test && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck"
  },
  "dependencies": {
    "@taquito/beacon-wallet": "25.0.0",
    "@taquito/taquito": "25.0.0",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5",
    "@taquito/utils": "25.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "oxlint": "1.88.0",
    "oxfmt": "0.73.0",
    "oxlint-tsgolint": "7.0.2004"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^24.0.0"
  }
}
